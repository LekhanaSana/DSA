arr = [3, 2, 1, 5, 6, 4]
k = 2

target = len(arr) - k
low = 0
high = len(arr) - 1

while low <= high:
    pivot = arr[high]
    i = low - 1

    for j in range(low, high):
        if arr[j] <= pivot:
            i += 1
            arr[i], arr[j] = arr[j], arr[i]

    arr[i + 1], arr[high] = arr[high], arr[i + 1]
    p = i + 1

    if p == target:
        print(arr[p])
        break
    elif p < target:
        low = p + 1
    else:
        high = p - 1
