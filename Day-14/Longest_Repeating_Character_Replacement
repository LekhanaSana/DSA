s = "AABABBA"
k = 1

left = 0
count = {}
max_freq = 0
longest = 0

for right in range(len(s)):
    ch = s[right]

    if ch in count:
        count[ch] += 1
    else:
        count[ch] = 1

    if count[ch] > max_freq:
        max_freq = count[ch]

    while (right - left + 1) - max_freq > k:
        count[s[left]] -= 1
        left += 1

    length = right - left + 1

    if length > longest:
        longest = length

print(longest)
