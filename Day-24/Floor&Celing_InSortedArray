
nums = [1, 2, 4, 6, 8]
target = 5

# Find floor
lo = 0
hi = len(nums) - 1
floor = -1

while lo <= hi:
    mid = (lo + hi) // 2

    if nums[mid] <= target:
        floor = nums[mid]
        lo = mid + 1  # Try to find a larger valid value
    else:
        hi = mid - 1

# Find ceiling
lo = 0
hi = len(nums) - 1
ceiling = -1

while lo <= hi:
    mid = (lo + hi) // 2

    if nums[mid] >= target:
        ceiling = nums[mid]
        hi = mid - 1  # Try to find a smaller valid value
    else:
        lo = mid + 1

print("Floor:", floor)
print("Ceiling:", ceiling)
