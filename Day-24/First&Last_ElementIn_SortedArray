
nums = [5, 7, 7, 8, 8, 10]
target = 8

# Find first occurrence
lo = 0
hi = len(nums) - 1
first = -1

while lo <= hi:
    mid = (lo + hi) // 2

    if nums[mid] == target:
        first = mid
        hi = mid - 1  # Search further left
    elif nums[mid] < target:
        lo = mid + 1
    else:
        hi = mid - 1

# Find last occurrence
lo = 0
hi = len(nums) - 1
last = -1

while lo <= hi:
    mid = (lo + hi) // 2

    if nums[mid] == target:
        last = mid
        lo = mid + 1  # Search further right
    elif nums[mid] < target:
        lo = mid + 1
    else:
        hi = mid - 1

print([first, last])
