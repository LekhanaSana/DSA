arr = [5, 3, 8, 1, 2]

for i in range(len(arr)):
    swapped = False

    for j in range(len(arr) - 1):
        if arr[j] > arr[j + 1]:
            temp = arr[j]
            arr[j] = arr[j + 1]
            arr[j + 1] = temp
            swapped = True

    if swapped == False:
        break

print(arr)
