numbers = [2, 7, 11, 15]
target = 9

left = 0
right = len(numbers) - 1

while left < right:

    total = numbers[left] + numbers[right]

    if total == target:
        print([left + 1, right + 1])
        break

    elif total < target:
        # Need a bigger sum
        left += 1

    else:
        # Need a smaller sum
        right -= 1
