intervals = [[1, 3], [2, 6], [8, 10], [15, 18]]

#Sort intervals by starting point
for i in range(1, len(intervals)):
    current = intervals[i]
    j = i - 1

    while j >= 0 and intervals[j][0] > current[0]:
        intervals[j + 1] = intervals[j]
        j -= 1

    intervals[j + 1] = current

#Start with the first interval
merged = [intervals[0]]

# Check the remaining intervals
for i in range(1, len(intervals)):
    current = intervals[i]
    last = merged[-1]

    if current[0] <= last[1]:
        # They overlap, so extend the last interval
        if current[1] > last[1]:
            last[1] = current[1]
    else:
        # No overlap, so add a new interval
        merged.append(current)

print(merged)
