intervals = [[1, 2], [2, 3], [3, 4], [1, 3]]

# Sort by ending point using insertion sort
for i in range(1, len(intervals)):
    current = intervals[i]
    j = i - 1

    while j >= 0 and intervals[j][1] > current[1]:
        intervals[j + 1] = intervals[j]
        j -= 1

    intervals[j + 1] = current

# Keep the interval that ends first
kept = 0
removed = 0
last_end = 0

for i in range(len(intervals)):
    if kept == 0:
        # The first interval can always be kept
        last_end = intervals[i][1]
        kept += 1
    elif intervals[i][0] >= last_end:
        # This interval does not overlap
        last_end = intervals[i][1]
        kept += 1
    else:
        # This interval overlaps, so remove it
        removed += 1

print(removed)
